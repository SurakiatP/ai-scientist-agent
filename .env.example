OPENROUTER_API_KEY=
MODEL=openai/gpt-6-luna
# Same as MODEL, so a failed call retries the same model: worst case ~13 min of slot per run (240 s/call + 315 s branch).
FALLBACK_MODEL=openai/gpt-6-luna
MAX_BRANCHES=5
MAX_CONCURRENT_RUNS=4
BRANCH_TOKEN_CAP=4000
BRANCH_MAX_ROUNDS=8
MAX_QUESTION_CHARS=2000
HERMES_SOURCE_PATH=~/.cache/scientist/upstream/hermes
HERMES_REVISION=c8301ea6c9b797184df16a9c5dd462400b264ff4
ENABLED_SKILLS=["paper-lookup"]
CORS_ORIGINS=["http://localhost:3000"]
MAX_PAPERS_PER_BRANCH=30
# max_tokens per call; reasoning models think inside this budget, so small values come back blank
GUARDRAIL_MAX_TOKENS=256
STRATEGY_MAX_TOKENS=1500
SYNTHESIS_MAX_TOKENS=4000
# optional: mailto in the citation-check User-Agent (Crossref/NCBI polite use); empty sends none
CONTACT_EMAIL=
# File uploads: MinIO runs inside this app's own stack. Empty MINIO_ENDPOINT turns uploads off (files routes answer 503).
# Credentials: set the plain value, or point *_FILE at a Docker-secret path (the file wins). Never commit real values.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# MINIO_ACCESS_KEY_FILE=/run/secrets/minio_access_key
# MINIO_SECRET_KEY_FILE=/run/secrets/minio_secret_key
MINIO_BUCKET=scientist-uploads
# per-file byte caps by extension (413 past the cap; counted while streaming)
UPLOAD_MAX_BYTES_CSV=100000000
UPLOAD_MAX_BYTES_PARQUET=100000000
UPLOAD_MAX_BYTES_XLSX=25000000
UPLOAD_MAX_BYTES_JSON=50000000
UPLOAD_MAX_BYTES_PDF=30000000
UPLOAD_MAX_BYTES_DOCX=30000000
# file parts accepted per request, and total request body cap (keep the reverse proxy body limit just above it)
UPLOAD_MAX_FILES=10
UPLOAD_MAX_TOTAL_BYTES=200000000

# data-analysis sandbox: one locked-down container per run (no network, read-only fs, non-root). Build the image:
#   docker build -t scientist-sandbox:latest backend/sandbox
# false = /v1/async/analyze answers 503 and /v1/health reports analysis: disabled
SANDBOX_ENABLED=true
SANDBOX_IMAGE=scientist-sandbox:latest
SANDBOX_MEM=2g
SANDBOX_CPUS=1.0
SANDBOX_TIMEOUT_S=60
SANDBOX_PIDS=128
# rows loaded from the uploaded file (the rest is dropped and reported as truncated)
SANDBOX_MAX_ROWS=2000000
SANDBOX_MAX_CONCURRENT=3
# cap on the JSON document (figures included) a run may print; reading stops and the container is killed beyond it
SANDBOX_OUTPUT_MAX_BYTES=10000000
# analyses allowed to wait for a sandbox slot; more get 429
ANALYZE_MAX_QUEUE=20
ANALYZE_MAX_TOKENS=3000
# document previews rendering at once; up to 10 more wait, the rest get 429; finished previews are kept briefly
PREVIEW_MAX_CONCURRENT=2
PREVIEW_TTL_SECONDS=600
PREVIEW_MAX_ENTRIES=20
