OPENROUTER_API_KEY=
MODEL=openai/gpt-6-luna
# Same as MODEL, so a failed call retries the same model: worst case ~13 min of slot per run (240 s/call + 315 s branch).
FALLBACK_MODEL=openai/gpt-6-luna
MAX_BRANCHES=5
MAX_CONCURRENT_RUNS=4
# Server-side run queue (needs DATABASE_URL). Per browser (random client id, fairness only): 1 running, 2 waiting; 20 waiting in all.
# More get 429 client_busy / queue_full. Finished runs and their stored events are deleted after RUN_RETENTION_DAYS.
MAX_RUNNING_PER_CLIENT=3
MAX_QUEUED_PER_CLIENT=1
RUN_QUEUE_MAX=20
RUN_RETENTION_DAYS=7
BRANCH_TOKEN_CAP=4000
BRANCH_MAX_ROUNDS=8
MAX_QUESTION_CHARS=2000
HERMES_SOURCE_PATH=~/.cache/scientist/upstream/hermes
HERMES_REVISION=c8301ea6c9b797184df16a9c5dd462400b264ff4
ENABLED_SKILLS=["paper-lookup"]
CORS_ORIGINS=["http://localhost:3000"]
MAX_PAPERS_PER_BRANCH=30
# max_tokens per call; reasoning models think inside this budget, so small values come back blank
GUARDRAIL_MAX_TOKENS=256
STRATEGY_MAX_TOKENS=1500
SYNTHESIS_MAX_TOKENS=4000
# optional: mailto in the citation-check User-Agent (Crossref/NCBI polite use); empty sends none
CONTACT_EMAIL=
# File uploads: MinIO runs inside this app's own stack. Empty MINIO_ENDPOINT turns uploads off (files routes answer 503).
# Credentials: set the plain value, or point *_FILE at a Docker-secret path (the file wins). Never commit real values.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# MINIO_ACCESS_KEY_FILE=/run/secrets/minio_access_key
# MINIO_SECRET_KEY_FILE=/run/secrets/minio_secret_key
MINIO_BUCKET=scientist-uploads
# Presigned file previews: the browser fetches from MinIO directly. PUBLIC_ENDPOINT = URL the BROWSER can reach (empty = MINIO_ENDPOINT).
# MinIO itself must allow your web origin (MINIO_API_CORS_ALLOW_ORIGIN). Disable to proxy previews through the backend.
MINIO_PUBLIC_ENDPOINT=
PRESIGN_ENABLED=true
PRESIGN_TTL_SECONDS=300
# per-file byte caps by extension (413 past the cap; counted while streaming)
UPLOAD_MAX_BYTES_CSV=100000000
UPLOAD_MAX_BYTES_PARQUET=100000000
UPLOAD_MAX_BYTES_XLSX=25000000
UPLOAD_MAX_BYTES_JSON=50000000
UPLOAD_MAX_BYTES_PDF=30000000
UPLOAD_MAX_BYTES_DOCX=30000000
# file parts accepted per request, and total request body cap (keep the reverse proxy body limit just above it)
UPLOAD_MAX_FILES=10
UPLOAD_MAX_TOTAL_BYTES=200000000

# data-analysis sandbox: one locked-down container per run (no network, read-only fs, non-root). Build the image:
#   docker build -t scientist-sandbox:latest backend/sandbox
# false = /v1/async/analyze answers 503 and /v1/health reports analysis: disabled
SANDBOX_ENABLED=true
SANDBOX_IMAGE=scientist-sandbox:latest
SANDBOX_MEM=2g
SANDBOX_CPUS=1.0
SANDBOX_TIMEOUT_S=60
SANDBOX_PIDS=128
# rows loaded from the uploaded file (the rest is dropped and reported as truncated)
SANDBOX_MAX_ROWS=2000000
SANDBOX_MAX_CONCURRENT=3
# cap on the JSON document (figures included) a run may print; reading stops and the container is killed beyond it
SANDBOX_OUTPUT_MAX_BYTES=10000000
# analyses allowed to wait for a sandbox slot; more get 429
ANALYZE_MAX_QUEUE=20
ANALYZE_MAX_TOKENS=3000
# document previews rendering at once; up to 10 more wait, the rest get 429; finished previews are kept briefly
PREVIEW_MAX_CONCURRENT=2
PREVIEW_TTL_SECONDS=600
PREVIEW_MAX_ENTRIES=20

# "answer research" mode: what the browser may send as session memory (newest turns kept; extra is clamped, not rejected)
CHAT_MEMORY_TURNS=8
CHAT_MEMORY_ANSWER_CHARS=6000
CHAT_MEMORY_REFS=40

# PostgreSQL (optional foundation, no app data lives in it yet). Empty DATABASE_URL = no database; /v1/health shows db: disabled.
# Dev: scripts/dev.sh starts scientist-dev-postgres on 127.0.0.1:55433 and exports this for you (DEV_NO_DB=1 skips it).
# Password: put it in the URL, or point DATABASE_PASSWORD_FILE at a Docker-secret path (the file wins). Never commit real values.
# Migrate: uv run --project backend alembic -c backend/alembic.ini upgrade head
DATABASE_URL=
# DATABASE_PASSWORD_FILE=/run/secrets/postgres_app_password
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT_S=3
DB_STATEMENT_TIMEOUT_MS=15000
# Shared data (/v1/store, needs DATABASE_URL + migration 0002). No login: everyone who reaches the server sees and edits everything.
TRASH_DAYS=7                  # deleted chats/projects/files stay restorable this long
STORE_MAX_SESSIONS=200        # sessions returned by one snapshot
MAX_TURNS_PER_SESSION=50      # newest turns per session in a snapshot
STORE_MAX_TURNS=500           # turns one session may hold
STORE_MAX_TURN_JSON_BYTES=200000  # progress/plan/analysis/answer, each
ALLOWED_ORIGINS=[]            # if set, a store write with an Origin header must match (writes must be application/json regardless)
USAGE_RETENTION_DAYS=180
# Behind a proxy set FORWARDED_ALLOW_IPS=<proxy address/CIDR> (read by uvicorn) so rate limits are per client
STORE_WRITE_RATE_PER_MIN=600  # writes per client IP per minute, 0 = unlimited
STORE_MAX_BODY_BYTES=1000000  # body cap for every store route except import
IMPORT_MAX_BYTES=10000000     # body cap for the one-shot import of old browser data
