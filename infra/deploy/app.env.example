# Copy to /etc/ai-scientist/private/app.env (mode 0600, root-owned). Never commit the real file.
DOMAIN=CHANGE_ME.example.com
ACME_EMAIL=CHANGE_ME@example.com
# CADDY_TLS=tls internal   # local rehearsal only
IMAGE_TAG=develop

OPENROUTER_API_KEY=CHANGE_ME
MODEL=openai/gpt-6-luna
FALLBACK_MODEL=openai/gpt-6-luna
HERMES_REVISION=c8301ea6c9b797184df16a9c5dd462400b264ff4
ENABLED_SKILLS=["paper-lookup"]
CONTACT_EMAIL=
MINIO_BUCKET=scientist-uploads
# MINIO_* endpoint and credentials are set by compose (secrets files minio-access-key / minio-secret-key).
MINIO_PUBLIC_ENDPOINT=https://files.CHANGE_ME.example.com
PRESIGN_ENABLED=true
PRESIGN_TTL_SECONDS=300
UPLOAD_MAX_FILES=10
UPLOAD_MAX_TOTAL_BYTES=200000000
# Data analysis needs a Docker-capable host runner, which this Compose stack does not have (the backend gets no docker.sock).
# Keep it off until a separate runner service exists; then /v1/async/analyze answers 503 and /v1/health shows analysis: disabled.
SANDBOX_ENABLED=false

# FORWARDED_ALLOW_IPS=<Caddy container address or CIDR>  # uvicorn trusts X-Forwarded-For only from here; makes the write rate limit per client
# PostgreSQL pool/timeouts (optional). DATABASE_URL and the password file are set by infra/compose.yaml; do not set them here.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT_S=3
DB_STATEMENT_TIMEOUT_MS=15000
