# Copy to /etc/ai-scientist/private/app.env (mode 0600, root-owned). Never commit the real file.
DOMAIN=CHANGE_ME.example.com
ACME_EMAIL=CHANGE_ME@example.com
# CADDY_TLS=tls internal   # local rehearsal only
IMAGE_TAG=develop

OPENROUTER_API_KEY=CHANGE_ME
MODEL=openai/gpt-6-luna
FALLBACK_MODEL=openai/gpt-6-luna
HERMES_REVISION=c8301ea6c9b797184df16a9c5dd462400b264ff4
ENABLED_SKILLS=["paper-lookup","database-lookup"]
CONTACT_EMAIL=
MINIO_BUCKET=scientist-uploads
# MINIO_* endpoint and credentials are set by compose (secrets files minio-access-key / minio-secret-key).
MINIO_PUBLIC_ENDPOINT=https://files.CHANGE_ME.example.com
PRESIGN_ENABLED=true
PRESIGN_TTL_SECONDS=300
UPLOAD_MAX_FILES=10
UPLOAD_MAX_TOTAL_BYTES=200000000
# Data analysis and research branches run in the isolated `sandbox` service (infra/compose.yaml); the backend gets no docker.sock.
# The stack REQUIRES the sandbox runner (sysbox) to start: the backend waits for it, and deploy.sh rolls back automatically if health fails.
# SANDBOX_ENABLED=false only turns analysis off: /v1/async/analyze answers 503 and /v1/health shows analysis: disabled.
# Sandbox limits (optional, read by compose; lower SANDBOX_CPUS on hosts with fewer than 3 CPUs; defaults leave headroom for postgres/backend/minio/caddy on an 8 GB / 4 CPU VM, raise on bigger VMs):
# SANDBOX_MEM_LIMIT=6g
# SANDBOX_CPUS=3
# SANDBOX_PIDS_LIMIT=4096
SANDBOX_ENABLED=true

# FORWARDED_ALLOW_IPS=<Caddy container address or CIDR>  # uvicorn trusts X-Forwarded-For only from here; makes the write rate limit per client
# PostgreSQL pool/timeouts (optional). DATABASE_URL and the password file are set by infra/compose.yaml; do not set them here.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT_S=3
DB_STATEMENT_TIMEOUT_MS=15000
# Run queue (runs belong to the server and continue after a tab closes; a restart marks unfinished ones interrupted).
# MAX_CONCURRENT_RUNS is the research slots; fairness is per browser client id.
MAX_CONCURRENT_RUNS=4
MAX_RUNNING_PER_CLIENT=3
MAX_QUEUED_PER_CLIENT=1
RUN_QUEUE_MAX=20
# Re-plan (deep mode): searches that find fewer than REPLAN_MIN_PAPERS papers (or fail) get extra rounds (0 = off) of up to REPLAN_MAX_SEARCHES new terms
REPLAN_ROUNDS=1
REPLAN_MIN_PAPERS=2
REPLAN_MAX_SEARCHES=3
# Reviewer pass: before delivery, cited claims are checked against the cited abstracts (exact quotes kept); a failure never fails the run
REVIEW_ENABLED=true
REVIEW_MAX_TOKENS=8000
RUN_RETENTION_DAYS=7
