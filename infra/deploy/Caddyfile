{
	admin off
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	{$CADDY_TLS}
	# Upload cap just above UPLOAD_MAX_TOTAL_BYTES (200 MB).
	request_body {
		max_size 210MB
	}
	# flush_interval -1: SSE stream of research events must not buffer.
	handle /v1/* {
		reverse_proxy backend:8000 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy frontend:3000
	}
}
