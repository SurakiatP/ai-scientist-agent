{
	admin off
	email {$ACME_EMAIL}
}

# Presigned file links. Same path and Host as signed (S3 signatures cover both), so no prefix and no rewrite. Read-only.
files.{$DOMAIN} {
	{$CADDY_TLS}
	@ro method GET HEAD
	handle @ro {
		reverse_proxy minio:9000
	}
	handle {
		respond "method not allowed" 405
	}
}

{$DOMAIN} {
	{$CADDY_TLS}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
	# Upload cap just above UPLOAD_MAX_TOTAL_BYTES (200 MB).
	request_body {
		max_size 210MB
	}
	# Research questions/plans are small: cap before parsing. Uploads (/v1/files) keep the 210MB cap above.
	@ask path /v1/async/*
	request_body @ask {
		max_size 1MB
	}
	# flush_interval -1: SSE stream of research events must not buffer.
	handle /v1/* {
		reverse_proxy backend:8000 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy frontend:3000
	}
}
